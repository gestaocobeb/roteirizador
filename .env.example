APP_NAME="Roteirizador"
APP_ENV=production
APP_DEBUG=false
APP_HTTPS=false
APP_BASE_PATH=
# Endereço público completo do sistema, usado no link de "Esqueci minha senha".
APP_URL=
APP_SESSION_NAME=roteirizador_session
APP_SESSION_IDLE_TIMEOUT=1800

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roteirizador
DB_USERNAME=
DB_PASSWORD=

# SMTP para o e-mail de "Esqueci minha senha" (MAIL_ENCRYPTION: tls, ssl ou vazio)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Roteirizador COBEB"
